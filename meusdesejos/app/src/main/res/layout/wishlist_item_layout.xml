<?xml version="1.0" encoding="utf-8"?>

<!-- Card de um item da lista de desejos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_white_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- "Foto" do produto (aqui é só um ícone, sem internet/API) -->
    <ImageView
        android:id="@+id/item_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/card_white_rounded"
        android:clipToOutline="true"
        android:contentDescription="@string/product_image"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_product_placeholder" />

    <!-- Coluna com nome, loja e preço -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_store"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/pink_dark"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Setinha indicando que dá pra clicar -->
    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/circle_gray_bg"
        android:contentDescription="@string/open_details"
        android:padding="8dp"
        android:src="@drawable/ic_chevron_right" />

</LinearLayout>
